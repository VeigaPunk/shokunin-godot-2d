
# baseline/frozen snapshot trees are regenerable; never track
live/*/tree/
live/*/frozen/
live/*/*tree*/
live/*/edge-verdicts.json
# xsentinel w8-F4: non-tree snapshot side-channel names — same class as the
# tree/frozen rules above (runs-extracted/ specimen existed at r66).
live/*/head/
live/*/snapshot/
live/*/base/
live/*/*extract*/
# xsentinel w9: *tree* dirs at ANY depth (same class as audio fix)
live/**/*tree*/
# r89 reviewer F2: regenerable machine artifacts corpus-wide — Python
# bytecode caches (fixtures + live drivers) and Godot .godot/ project caches.
**/__pycache__/
**/.godot/
